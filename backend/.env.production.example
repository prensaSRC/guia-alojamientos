# ===== Configuración de producción (backend) — referencia =====
# Estas variables van a las Variables de entorno del servicio en Railway.
# Este archivo es solo de referencia. Los valores reales van al panel de
# Railway o, para pruebas locales, a backend/.env.production (gitignoreado).

# Cadena completa de conexión MySQL provista por Clever Cloud:
#   mysql://usuario:password@host:puerto/nombre_db
DB_URL=mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB

# SSL contra la base de datos (Clever Cloud lo requiere para conexiones remotas).
DB_USE_SSL=true

# Dominio del frontend publicado en Netlify (origen permitido por CORS).
FRONTEND_URL=https://mi-sitio.netlify.app

# Secreto para firmar los JWT. Generá uno fuerte, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=cambia_por_un_secreto_fuerte

# Credenciales del usuario administrador (las usa `npm run seed:admin`).
ADMIN_EMAIL=admin@santarosacalamuchita.gob.ar
ADMIN_PASSWORD=cambia_esta_contraseña_admin
ADMIN_NOMBRE=Administrador